{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genshin Wishing Calculator",
  "version": "2.0.0",
  "identifier": "dev.hydrate.wishcalc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genshin Wishing Calculator",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0A0910"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://paimon.moe https://raw.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Tracks your Genshin Impact pity on every banner"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNEU5OUQ0RDJERDI0REQKUldUZEpOM1MxSmxPY3NKdXNzQ05BMWdQN1cvZGRhUXRpK2lib1RSNHZXWURKbThlV1l5LzNXdXkK",
      "endpoints": ["https://github.com/Hydrate36/Genshin-Wishing-Calculator/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
